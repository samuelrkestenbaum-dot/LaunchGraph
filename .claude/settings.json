{
  "env": {
    "BUILD_OS_SPECIALIST_HANDOFF": "1",
    "BUILD_OS_SOURCE": "/home/user/LaunchGraph"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-build-os.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/prompt-router.sh"
          }
        ]
      }
    ]
  }
}
