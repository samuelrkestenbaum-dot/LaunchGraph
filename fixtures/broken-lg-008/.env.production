# Production configuration. Clean on LG-001 (https origin) and LG-015 (one
# consistent host). SEEDED DEFECT (LG-008): the DATABASE_URL value below is
# byte-identical to the .env.preview value, so preview deployments use the
# production database. The fake DB URL uses a short (<20 alnum) suffix.
NEXT_PUBLIC_SITE_URL=https://app.example.com
DATABASE_URL=postgresql://db.example.com:5432/appdb
